# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
BASE_URL=http://localhost:3000

# Auth (dev | oidc)
AUTH_MODE=dev

# Database (leave empty for pg-mem in local dev/tests)
DATABASE_URL=

# Multi-tenancy & i18n
DEFAULT_ORGANIZATION_SLUG=riihimaki
DEFAULT_LOCALE=fi
ENABLED_LOCALES=fi

# File storage (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads

# Reporting & privacy
REPORTER_HASH_SECRET=dev-secret

# Metrics (optional bearer token for /metrics)
METRICS_BEARER_TOKEN=

# Seed demo data on startup if database is empty (true | false)
SEED_DEMO_DATA=true
