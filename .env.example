# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
BASE_URL=http://localhost:3000

# Auth (dev | oidc)
AUTH_MODE=dev
# In AUTH_MODE=dev (non-production): free entry default role (admin | keeper | member | none)
DEV_DEFAULT_ROLE=admin
SESSION_SECRET=dev-session-secret
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES="openid profile email groups"
# OIDC_GROUP_ROLE_MAP values can be "member"|"keeper"|"admin" (default org) or {"org":"<slug>","role":"member"|"keeper"|"admin"}
OIDC_GROUP_ROLE_MAP={"parish/riihimaki":"member","parish/riihimaki/tavaranpaikka-keeper":"keeper","parish/riihimaki/tavaranpaikka-admin":"admin"}

# Database (leave empty for pg-mem in local dev/tests)
DATABASE_URL=

# Multi-tenancy & i18n
DEFAULT_ORGANIZATION_SLUG=riihimaki
# Optional JSON array of additional existing/seeded organizations: [{"slug":"hyvinkaa","name":"Hyvinkään seurakunta"}]
ORGANIZATIONS=[]
DEFAULT_LOCALE=fi
ENABLED_LOCALES=fi

# File storage (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=tavaranpaikka-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_ENSURE_BUCKET=false

# Reporting, privacy & retention
REPORTER_HASH_SECRET=dev-secret
LEASE_RETENTION_DAYS=365
CLEANUP_DISABLED=false
EXPIRY_NOTIFY_DAYS=60

# Mail delivery (console | brevo | oidc)
MAIL_PROVIDER=console
MAIL_FROM=tavaranpaikka@riihimaenseurakunta.fi
MAIL_ADMIN_FALLBACK=
BREVO_API_KEY=
# Shared fallback template ID (used when a specific template ID below is empty)
BREVO_TEMPLATE_DEFAULT_ID=
BREVO_TEMPLATE_REPORT_ID=
BREVO_TEMPLATE_EXPIRING_ID=
BREVO_TEMPLATE_INSPECTION_ID=
BREVO_TEMPLATE_DIGEST_ID=
OIDC_MAIL_ENDPOINT=
OIDC_MAIL_TOKEN=

# Metrics (optional bearer token for /metrics)
METRICS_BEARER_TOKEN=

# Seed demo data on startup if database is empty (true | false)
SEED_DEMO_DATA=true
